# Copy this file to .env and fill in your key:  cp env.example .env
# python-dotenv loads it in main.py via load_dotenv().

# Required: your Anthropic API key.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: model to use. If unset, the code defaults to claude-sonnet-4-6.
# To iterate cheaply over the loop you can use claude-haiku-4-5-20251001.
GD_MODEL=claude-sonnet-4-6
