# Copiá este archivo a .env y completá tu key:  cp env.example .env
# python-dotenv la carga en main.py vía load_dotenv().

# Requerida: tu API key de Anthropic.
ANTHROPIC_API_KEY=sk-ant-...

# Opcional: modelo a usar. Si no la definís, el código usa claude-sonnet-4-6.
# Para iterar barato en el loop podés usar claude-haiku-4-5-20251001.
GD_MODEL=claude-sonnet-4-6
