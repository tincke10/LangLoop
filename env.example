# Copy this file to .env and fill in your key:  cp env.example .env
# python-dotenv loads it in main.py via load_dotenv().

# ---- Model configuration (used by init_chat_model in nodes.py) ----
# model provider, e.g. anthropic, openai, google_genai. Defaults to "anthropic".
MODEL_PROVIDER=anthropic

# model name. If unset, the code defaults to claude-sonnet-4-6.
# To iterate cheaply over the loop you can use claude-haiku-4-5-20251001.
MODEL=claude-sonnet-4-6

# key / API key for the chosen provider. Falls back to ANTHROPIC_API_KEY if unset.
API_KEY=

# baseurl / custom API base URL (optional, for proxies / compatible endpoints).
BASE_URL=
